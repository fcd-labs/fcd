---
import Default from "@astrojs/starlight/components/Footer.astro";
---

<Default><slot /></Default>

<p class="licentie">
  sim007 — tekst <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>,
  code <a href="https://github.com/fcd-labs/fcd/blob/main/LICENSE">MIT</a>
</p>

<script>
  // Mermaid alleen laden op pagina's met een diagram.
  const blokken = document.querySelectorAll<HTMLElement>("pre.mermaid");
  if (blokken.length) {
    const { default: mermaid } = await import("mermaid");
    const donker = document.documentElement.dataset.theme !== "light";
    mermaid.initialize({ startOnLoad: false, theme: donker ? "dark" : "default" });
    await mermaid.run({ nodes: [...blokken] });
  }
</script>

<style>
  .licentie {
    margin-top: 1.5rem;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
</style>
